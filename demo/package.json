{
  "name": "mixoutlet-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --no-warnings --test test/unit.mjs test/unit-*.mjs",
    "test:e2e": "node test/e2e.mjs \"$PWD\"",
    "test:coverage": "c8 --reporter=text-summary --reporter=lcov --include=\"*.mjs\" --include=\"lib/**\" --include=\"services/**\" --include=\"routes/**\" --include=\"jobs/**\" --include=\"db/**\" --include=\"instagram/**\" --include=\"marketing/**\" --exclude=\"test/**\" --exclude=\"node_modules/**\" npm test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run test:browser",
    "test:browser": "node test/browser.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "c8": "^10.1.3",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3"
  }
}
